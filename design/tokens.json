{
  "$schema_note": "Golf CRM v2 design tokens — canonical source of truth at projects/Golf/design/tokens.json; wired into tailwind.config.js in a later phase",
  "meta": { "project": "Golf", "preset": "premium-saas", "mood": "fairway at dusk" },

  "colors": {
    "brand": { "DEFAULT": "#155E3F", "light": "#2E9A6A", "dark": "#0E4B31", "gold": "#C9A961", "goldMuted": "#A8884A" },
    "light": {
      "bg": "#F6F5F1", "surface": "#FFFFFF", "surfaceAlt": "#EFEDE7",
      "text": "#1C1917", "textMuted": "#57534E", "border": "#E2DFD8"
    },
    "dark": {
      "bg": "#0B120E", "surface": "#121C16", "surfaceAlt": "#16221B",
      "text": "#EAEFEA", "textMuted": "#9BA8A0", "border": "#24332A"
    },
    "semantic": {
      "success": "#2E9A6A", "warning": "#C9A961", "danger": "#B4452F", "info": "#3E7CA8"
    },
    "status": {
      "confirmed": "#2E9A6A", "pending": "#C9A961", "cancelled": "#B4452F",
      "noShow": "#8A6D3B", "completed": "#5C7C6B",
      "membershipActive": "#2E9A6A", "membershipExpiring": "#C9A961", "membershipExpired": "#9B6B5E"
    }
  },

  "typography": {
    "fontFamily": {
      "sans": ["Inter", "system-ui", "sans-serif"],
      "display": ["Fraunces", "Georgia", "serif"],
      "mono": ["IBM Plex Mono", "ui-monospace", "monospace"]
    },
    "displayUsage": "Fraunces STRICTLY dosed: KPI numbers, page titles, premium accents only. All other UI stays Inter.",
    "numeric": { "tabular": "font-variant-numeric: tabular-nums" },
    "scale": {
      "pageTitle": "clamp(1.6rem, 2.5vw, 2.25rem)",
      "kpi": "clamp(1.75rem, 3vw, 2.75rem)",
      "h2": "1.25rem", "body": "0.95rem", "sm": "0.825rem", "xs": "0.75rem"
    },
    "weight": { "regular": 400, "medium": 500, "semibold": 600 },
    "tracking": { "tight": "-0.02em", "normal": "0", "wide": "0.04em" }
  },

  "spacing": {
    "density": {
      "compact": { "rowH": "32px", "cellPadX": "8px", "cellPadY": "4px" },
      "cozy":    { "rowH": "44px", "cellPadX": "12px", "cellPadY": "8px" }
    },
    "scale": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px", "6": "32px", "8": "48px" }
  },

  "radius": { "sm": "6px", "md": "10px", "lg": "14px", "xl": "20px", "pill": "999px" },

  "shadows": {
    "sm": "0 1px 2px rgba(14,75,49,0.06)",
    "md": "0 4px 12px rgba(14,75,49,0.10)",
    "lg": "0 12px 32px rgba(11,18,14,0.18)",
    "focus": "0 0 0 3px rgba(46,154,106,0.45)"
  },

  "motion": {
    "duration": { "fast": "120ms", "normal": "200ms", "slow": "320ms" },
    "easing": { "out": "cubic-bezier(0.22,1,0.36,1)", "inOut": "cubic-bezier(0.65,0,0.35,1)" },
    "reducedMotion": "respect prefers-reduced-motion: disable non-essential transitions"
  },

  "layout": {
    "sidebarWidth": "248px", "sidebarCollapsed": "64px",
    "topbarHeight": "56px", "contentMax": "1440px",
    "breakpoints": { "sm": "640px", "md": "768px", "lg": "1024px", "xl": "1280px" }
  },

  "states": {
    "loading": "skeleton blocks (surfaceAlt shimmer), never spinner-only",
    "empty": "centered guided message + primary CTA",
    "error": "danger-tinted panel + retry",
    "focusRing": "shadows.focus",
    "hover": "surfaceAlt @ duration.fast",
    "disabled": "opacity 0.5, no pointer"
  }
}
