{
  "name": "golf-frontend",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 5173",
    "lint": "eslint src --max-warnings=0",
    "test:lint": "node --test tests/lint-gate.test.mjs",
    "test:build-config": "node --test tests/build-config.test.mjs",
    "check": "npm run lint && npm run test:lint && npm run test:build-config && npm run build"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "7.18.3",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@jridgewell/gen-mapping": "^0.3.13",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/parser": "8.65.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "7.3.6"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
